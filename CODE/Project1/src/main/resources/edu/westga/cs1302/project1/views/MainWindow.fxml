<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="840.0" prefWidth="557.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.project1.views.MainWindow">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <AnchorPane prefHeight="818.0" prefWidth="517.0">
         <children>
            <Button layoutX="204.0" layoutY="224.0" mnemonicParsing="false" prefHeight="32.0" prefWidth="52.0" text="Button" />
            <TextField fx:id="title" layoutX="69.0" layoutY="177.0" prefHeight="25.0" prefWidth="347.0" />
            <Label layoutX="218.0" layoutY="134.0" text="Title" />
            <ListView layoutX="71.0" layoutY="288.0" onMouseClicked="#selectMovie" prefHeight="223.0" prefWidth="347.0" />
            <Label layoutX="216.0" layoutY="540.0" text="Favorite" />
            <ComboBox fx:id="favoriteMovieSelector" layoutX="155.0" layoutY="568.0" onAction="#popUpFavorite" prefWidth="150.0" />
         </children>
      </AnchorPane>
   </children>
</VBox>
